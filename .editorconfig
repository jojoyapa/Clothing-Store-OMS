root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Java
[*.java]
indent_size = 4

# Backend configs
[*.{xml,properties,gradle}]
indent_size = 4

# Database
[*.sql]
indent_size = 4

# Frontend:
[*.{js,jsx,ts,tsx,html,css,scss,json,yml,yaml}]
indent_size = 2
